generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MERCADOPAGO
  PAYPAL
}

enum PaymentStatus {
  INITIATED
  APPROVED
  REJECTED
  REFUNDED
}

enum ProductResourceType {
  LINK
  FILE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
  SUSPENDED
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)

  firstName    String?
  lastName     String?
  country      String? // "AR" u otro

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders       Order[]
  subscription Subscription?
  accessGrants AccessGrant[]
}

model Product {
  id              String  @id @default(uuid())
  title           String
  description     String?
  price           Int     // centavos
  currency        String  @default("ARS")
  isActive        Boolean @default(true)

  isSubscription  Boolean @default(false)
  requiresPremium Boolean @default(false)

  coverImageUrl   String?

  resourceType    ProductResourceType @default(LINK)
  resourceUrl     String? // NO exponer en endpoints públicos

  paypalPlanId    String?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  orderItems      OrderItem[]
  accessGrants    AccessGrant[]
}

model Order {
  id          String        @id @default(uuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])

  status      OrderStatus   @default(PENDING)
  provider    PaymentProvider
  providerRef String?       // preferenceId o paypalOrderId

  totalAmount Int
  currency    String

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  items       OrderItem[]
  payments    Payment[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  productId String

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  quantity  Int     @default(1)
  unitPrice Int     // centavos

  createdAt DateTime @default(now())
}

model Payment {
  id         String        @id @default(uuid())
  orderId    String
  order      Order         @relation(fields: [orderId], references: [id])

  provider   PaymentProvider
  status     PaymentStatus @default(INITIATED)

  externalId String?       @unique
  raw        Json?

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model AccessGrant {
  id        String  @id @default(uuid())
  userId    String
  productId String

  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  orderId   String?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Subscription {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id])

  provider           PaymentProvider
  status             SubscriptionStatus @default(ACTIVE)

  externalId          String? @unique
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  cancelAtPeriodEnd   Boolean @default(false)

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}