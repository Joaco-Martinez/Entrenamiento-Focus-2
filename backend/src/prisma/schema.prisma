generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")  // (ponelo si no lo tenés en otro lado)
}

enum Role {
  ADMIN
  USER
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  REFUNDED
}

enum PaymentProvider {
  MERCADOPAGO
  PAYPAL
}

enum PaymentStatus {
  INITIATED
  APPROVED
  REJECTED
  REFUNDED
}

enum ProductResourceType {
  LINK
  FILE
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
  SUSPENDED
}

enum SubscriptionLinkIntentStatus {
  PENDING
  MATCHED
  ACTIVATED
  FAILED
  EXPIRED
}

enum ServiceType {
  MIX
  MASTERING
  MIX_MASTERING
}

enum ServiceRequestStatus {
  AWAITING_PAYMENT
  AWAITING_MATERIAL
  IN_PROGRESS
  DELIVERED
}

enum VideoClassStatus {
  DRAFT
  PUBLISHED
}

model SubscriptionLinkIntent {
  id        String @id @default(uuid())

  userId    String
  user      User   @relation(fields: [userId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  provider  PaymentProvider @default(MERCADOPAGO)

  planId      String
  checkoutUrl String
  email       String
  payerEmail  String?

  status SubscriptionLinkIntentStatus @default(PENDING)

  mpPreapprovalId String?
  mpStatus        String?

  openedAt     DateTime?
  matchedAt    DateTime?
  activatedAt  DateTime?
  expiresAt    DateTime?
  lastWebhookAt DateTime?

  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([productId])
  @@index([provider])
  @@index([planId])
  @@index([email])
  @@index([status])
  @@index([mpPreapprovalId])
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  role         Role   @default(USER)
  phone     String?
  firstName String?
  lastName  String?
  country   String? @default("arg")

 resetPasswordCode          String?
  resetPasswordCodeExpiresAt DateTime?
  resetPasswordRequestedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
subscriptionLinkIntents SubscriptionLinkIntent[]
  orders       Order[]
  subscription Subscription?
  accessGrants AccessGrant[]
  serviceRequests ServiceRequest[]
  forumPosts    ForumPost[]
  forumComments ForumComment[]
  videoClasses  VideoClass[]
}

model Product {
  id          String  @id @default(uuid())
  title       String
  description String?

  arPrice  Int @default(0)
  usdPrice Int @default(0)
subscriptionLinkIntents SubscriptionLinkIntent[]
  isActive        Boolean @default(true)
  isSubscription  Boolean @default(false)
  requiresPremium Boolean @default(false)

  coverImageUrl String?

  resourceType ProductResourceType @default(LINK)
  resourceUrl  String?

  paypalPlanId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems    OrderItem[]
  accessGrants  AccessGrant[]
  subscriptions Subscription[] // 👈 AGREGAR
}

model Order {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  status      OrderStatus     @default(PENDING)
  provider    PaymentProvider
  providerRef String?

  totalAmount Int
  currency    String

  paidAt      DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    OrderItem[]
  payments Payment[]
  serviceRequests ServiceRequest[]
}

model OrderItem {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  // Un OrderItem es de un Product O de una VideoClass, nunca los dos
  // (constraint reforzada también a nivel DB, ver migración).
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  classId    String?
  videoClass VideoClass? @relation(fields: [classId], references: [id])

  quantity  Int @default(1)
  unitPrice Int // en centavos (o pesos, pero dejalo consistente)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
  @@index([classId])
}

model Payment {
  id String @id @default(uuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  provider PaymentProvider
  status   PaymentStatus   @default(INITIATED)

  // MP: paymentId (o merchant_order_id); PayPal: captureId, etc.
  externalId String? @unique

  // MP: preferenceId (porque el pago viene desde una preference)
  preferenceId String?

  // MP: status_detail, payment_method_id, installments, etc.
  statusDetail  String?
  paymentMethod String?
  installments  Int?

  amount   Int? // útil para auditoría
  currency String?

  raw Json?

  paidAt      DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([provider])
  @@index([status])
  @@index([externalId])
  @@index([preferenceId])
}

model AccessGrant {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  // Igual que en OrderItem: exactamente uno de los dos.
  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  classId    String?
  videoClass VideoClass? @relation(fields: [classId], references: [id])

  orderId   String?
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@unique([userId, classId])
  @@index([userId])
  @@index([productId])
  @@index([classId])
  @@index([orderId])
}

model Subscription {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  provider PaymentProvider
  status   SubscriptionStatus @default(PAST_DUE)

  externalId     String? @unique
  providerStatus String?
  payerEmail     String?

  cancelAtPeriodEnd Boolean   @default(false)
  cancelledAt       DateTime?

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  raw Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([provider])
  @@index([status])
  @@index([externalId])
}

model ServiceRequest {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id])

  serviceType ServiceType
  songCount   Int

  status ServiceRequestStatus @default(AWAITING_PAYMENT)

  materialLink String?
  genre        String?
  references   String?
  comments     String?

  deliveredFileUrl String?

  deliveryDueAt DateTime?
  deliveredAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orderId])
  @@index([status])
}

model ForumPost {
  id          String   @id @default(uuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id])
  title       String
  content     String
  tags        String[] @default([])
  articleSlug String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  comments    ForumComment[]

  @@index([authorId])
  @@index([articleSlug])
}

model ForumComment {
  id            String    @id @default(uuid())
  postId        String
  post          ForumPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId      String
  author        User      @relation(fields: [authorId], references: [id])
  content       String?
  audioUrl      String?
  audioPublicId String?
  audioDuration Int?
  audioPeaks    Int[]     @default([])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([postId])
  @@index([authorId])
}

model VideoClass {
  id          String @id @default(uuid())
  title       String
  slug        String @unique
  description String?

  coverImageUrl       String?
  coverImagePublicId  String?

  bunnyVideoId    String?
  durationSeconds Int?

  arPrice  Int @default(0)
  usdPrice Int @default(0)

  status VideoClassStatus @default(DRAFT)

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems   OrderItem[]
  accessGrants AccessGrant[]

  @@index([status])
  @@index([createdById])
}

model Article {
  id            String   @id @default(uuid())
  title         String
  slug          String   @unique
  excerpt       String
  content       String
  coverImageUrl String?
  authorName    String   @default("Entrenamiento Focus")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
