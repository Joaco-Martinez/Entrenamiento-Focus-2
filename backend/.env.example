PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

JWT_SECRET=super_secret_change_me
JWT_EXPIRES_IN=7d

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/back_focus?schema=public"

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mercado Pago
MP_ACCESS_TOKEN=
# Ambas rutas de webhook (la vieja /webhooks/mercadopago y la activa
# /mercadopago_checkout/webhook) procesan pagos con el mismo manejador, pero
# la que hay que configurar en MP y acá es la del checkout de clases/productos:
MP_NOTIFICATION_URL=https://tu-back.com/mercadopago_checkout/webhook
MP_SUCCESS_URL=https://tu-front.com/pay/mp/success
MP_FAILURE_URL=https://tu-front.com/pay/mp/failure
MP_PENDING_URL=https://tu-front.com/pay/mp/pending

# Mercado Pago Checkout Bricks (usado por /mercadopago_checkout/*, incluida la
# compra de clases). Access token propio de esta integración y el secreto
# usado para validar la firma (x-signature) del webhook.
MP_ACCESS_TOKEN_CHECKOUT_BRICKS=
MP_WEBHOOK_KEY_CHECKOUT_BRICKS=

# PayPal general
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_URL=https://tu-back.com/webhooks/paypal

# PayPal suscriptions (recomendado usar estas para este módulo)
PAYPAL_SUSCRIPTION_CLIENT_ID=
PAYPAL_SUSCRIPTION_CLIENT_SECRET=
PAYPAL_SUSCRIPTION_WEBHOOK_ID=
PAYPAL_SUSCRIPTION_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_SUSCRIPTION_RETURN_URL=http://localhost:3000/subscription/paypal/return
PAYPAL_SUSCRIPTION_CANCEL_URL=http://localhost:3000/subscription/paypal/cancel
PAYPAL_SUSCRIPTION_WEBHOOK_URL=https://tu-back.com/paypal_suscription/webhook
